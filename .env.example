# 공공데이터포털(data.go.kr) 에서 발급받은 일반 인증키(Decoding)
HIRA_SERVICE_KEY=PUT_YOUR_DECODED_SERVICE_KEY_HERE

# 호출 베이스 URL (서비스마다 다름, 필요시 endpoints.py에서 오버라이드)
HIRA_BASE_URL=https://apis.data.go.kr/B551182/msupUserInfoService1.2

# 요청당 페이지 크기 (서비스별 상한 확인 후 조정)
HIRA_PAGE_SIZE=1000

# 동시 요청 수 (rate limit 회피)
HIRA_CONCURRENCY=2
